# Copy to .env in the repository root. Generate a random JWT key before running.
APP_ENV=development
JWT_SECRET=

# Optional HTTP telemetry. Configure all three together.
TELEMETRY_COLLECTOR_URL=
TELEMETRY_APP_ID=
TELEMETRY_HMAC_KEY=
SESSION_MINUTES=30
SESSION_CROSS_SITE=false
SQLITE_PATH=portal.sqlite3
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:8000
# Local bootstrap leaves seed data off unless requested. The Render API sets this to true.
SEED_DEMO_DATA=false
# Optional synthetic accounts. Use independent random passwords of at least 24 characters on Render.
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
DEMO_STUDENT_EMAIL=
DEMO_STUDENT_PASSWORD=
